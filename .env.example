# -----------------------------------------------------------
# QR Order Notification & Mobile Pager SaaS - Environment
# -----------------------------------------------------------

# Application
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:3000

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=qr_order_db
MYSQL_USER=qr_user
MYSQL_PASSWORD=qr_password
DB_HOST=mysql_db
DB_PORT=3306

# JWT (must be at least 32 characters)
JWT_SECRET=please-change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# VAPID keys for Web Push (generate with: node -e "const webpush=require('web-push');console.log(webpush.generateVAPIDKeys())")
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@example.com

# CORS
CORS_ORIGIN=http://localhost:3000

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
